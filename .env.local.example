# Copy to .env.local and fill in. Every name below is read by the code;
# anything else in an old .env.local is unused.

# Supabase (Project Settings → API keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only admin key (src/lib/supabase/admin.ts): account deletion,
# Stripe webhook, invite gate, keepalive cron, /admin, test scripts.
SUPABASE_SECRET_KEY=sb_secret_...

# Google Gemini (AI Studio key; the project needs billing on, the free
# tier caps each model at 20 requests a day). Model IDs: src/lib/gemini.ts
GOOGLE_API_KEY=...
# Optional: swap the quality model without a deploy (must accept
# thinkingBudget, e.g. gemini-2.5-flash). Leave unset in production.
# GEMINI_QUALITY_MODEL=

# Upstash Redis (the Vercel KV store) for daily caps
KV_REST_API_URL=https://...upstash.io
KV_REST_API_TOKEN=...

# Stripe
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_WEEKLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# Resend (in-app feedback form → hello@linette.app)
RESEND_API_KEY=re_...

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...

# Vercel cron (/api/cron/keepalive). Vercel sends it as a Bearer token.
CRON_SECRET=a-long-random-string

# Admin gate — email of the user allowed to see /admin (the usage
# dashboard). Anyone else hitting /admin gets a 404. Add to Vercel
# env vars too, otherwise prod /admin returns 404 for you.
ADMIN_EMAIL=you@example.com
# Comma-separated emails that skip the daily caps and the paywall
# (confirmed emails only).
CAP_BYPASS_EMAILS=

# Invite-only beta gate, ON unless this is "false": a brand-new Google
# (OAuth) account with no invite gets deleted at the callback. Set
# INVITE_ONLY=false at public launch.
# INVITE_ONLY=false

# Optional background-removal tuning (src/lib/cutout/model.ts)
# CUTOUT_THREADS=2
# CUTOUT_MODEL_URL=

# Playwright. test:rules needs a DEDICATED account (email contains "e2e"
# or "harness"); with no HARNESS_PASSWORD it signs in via the admin API.
HARNESS_EMAIL=
# HARNESS_PASSWORD=
# Stress specs (stress-*.spec.ts) still log in with a password. Use a
# test account, never a real person's.
STRESS_TEST_EMAIL=
STRESS_TEST_PASSWORD=
