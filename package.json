{
  "name": "wardrobe-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:ts7": "next typegen && npx --yes -p typescript@7.0.2 -c \"tsc --noEmit\"",
    "test:unit": "vitest run",
    "test:smoke": "playwright test ui-smoke.spec.ts stress-crud.spec.ts",
    "test:stress": "playwright test ui-smoke.spec.ts stress-crud.spec.ts stress-suggest.spec.ts stress-tryon.spec.ts stress-packing.spec.ts stress-wear-today.spec.ts",
    "test:stress:fast": "playwright test ui-smoke.spec.ts stress-crud.spec.ts stress-wear-today.spec.ts",
    "test:stress:ai": "playwright test stress-suggest.spec.ts stress-tryon.spec.ts stress-packing.spec.ts",
    "test:rules": "playwright test rule-compliance.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@google/genai": "^2.30.0",
    "@sentry/nextjs": "^11.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/redis": "1.39.0",
    "chroma-js": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.6",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "opentype.js": "^2.0.0",
    "shadcn": "4.22.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
